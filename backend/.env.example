# Proposal-aligned central PostgreSQL database (matches compose.yaml)
DATABASE_URL=postgresql://surgimap:surgimap@localhost:5432/surgimap

# Optional sync endpoint override
SURGIMAP_SYNC_URL=http://127.0.0.1:8000/sync/inventory
SURGIMAP_SYNC_API_KEY=replace-with-a-long-random-secret
SURGIMAP_SYNC_INTERVAL_SECONDS=30

# Pharmacy portal demo account (change every value outside local development)
SURGIMAP_PHARMACY_EMAIL=pharmacy@surgimap.lk
SURGIMAP_PHARMACY_PASSWORD=pharmacy123
SURGIMAP_PHARMACY_NAME=City Med Pharmacy
SURGIMAP_PHARMACY_ID=1
SURGIMAP_AUTH_SECRET=replace-with-another-long-random-secret

# Zero-setup local fallback when PostgreSQL is unavailable
# DATABASE_URL=sqlite:///./surgimap.db
